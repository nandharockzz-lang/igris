#!/usr/bin/env python3
"""Read and write ~/.config/jarvis/config.toml from outside Python.

The bar widget's settings panel is QML, which has no TOML support, so it
shells out to this. Two commands:

    jarvis-config show            effective settings as JSON
    jarvis-config set KEY VALUE   change one setting

`set` rewrites a single line in place rather than re-serialising the file,
so the comments people rely on when hand-editing survive.
"""

import argparse
import importlib.util
import json
import os
import re
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
import safefile  # noqa: E402  (needs HERE on the path first)

CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME") or os.path.join(
    os.path.expanduser("~"), ".config")
CONFIG_PATH = os.path.join(CONFIG_HOME, "jarvis", "config.toml")


def load_daemon():
    """Import jarvis-listen.py for DEFAULTS/merge/Agent, so the two agree."""
    path = os.path.join(HERE, "jarvis-listen.py")
    spec = importlib.util.spec_from_file_location("jarvis_listen", path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


# Only these may be written from the panel. Anything touching how an agent is
# invoked stays in the file, editable by hand -- a GUI that can rewrite argv
# is a GUI that can be talked into running something. `mode` is settable
# because picking it in the panel IS the explicit physical action workspace
# mode requires -- but the daemon still enforces every mode invariant at
# startup, so no click can silently grant more than the mode allows.
WRITABLE = {
    "agent":                  "str",
    "mode":                   "str",
    "wake_word":              "str",
    "voice":                  "str",
    "model":                  "str",  # Top-level model setting for OpenCode agent
    "draggable_avatar_enabled": "bool",
    "listen.wake_threshold":  "float",
    "listen.silence_tail":    "float",
    "listen.min_speech":      "float",
    "listen.max_command":     "float",
    "listen.cooldown":        "float",
    "stt.engine":             "str",
    "stt.model":              "str",
    "stt.language":           "str",
    "stt.vocabulary":         "str",
    "stt.cloud_fallback":     "bool",
    "stt.fallback_engine":    "str",
    "workspace.auto_disarm_seconds": "float",
    "workspace.full_disarm_seconds": "float",
}


# A control character in a string value would be written into config.toml
# literally. A newline in particular ends the `key = "value"` line early and
# turns the rest of the value into further TOML -- which does not become an
# injected [agents.*] section (the value's opening quote is never closed, so
# the file stops parsing), but it does silently corrupt the config. The
# daemon then falls back to DEFAULTS on its next restart, quietly dropping
# every agent, key and setting the user had configured. Fail on the write
# instead of failing silently later.
CONTROL_CHARS = re.compile(r"[\x00-\x1f\x7f]")


def coerce_kind(kind, key, raw):
    if kind == "float":
        try:
            return float(raw)
        except ValueError:
            raise SystemExit(f"{key} must be a number, got {raw!r}")
    if kind == "bool":
        if raw.lower() in ("true", "false"):
            return raw.lower() == "true"
        raise SystemExit(f"{key} must be true or false, got {raw!r}")
    if CONTROL_CHARS.search(raw):
        raise SystemExit(f"{key} may not contain control characters")
    return raw


def coerce(key, raw):
    return coerce_kind(WRITABLE[key], key, raw)


def validate(daemon, key, value, config_path):
    """Reject values the daemon would refuse at startup, while the panel can
    still show an error -- better than a listener that dies on restart."""
    if key == "wake_word":
        # Only what is actually on disk can be selected: accepting a name
        # with no model file bricks the listener into a restart loop. The
        # write below runs only after this passes, so a refusal keeps the
        # prior working wake word untouched.
        installed = daemon.wake_models()
        if value not in installed:
            known = ", ".join(sorted(installed)) or "none"
            hint = ""
            if value == "igris":
                hint = (f" Train or download igris_v0.1.onnx, install it "
                        f"with: jarvis-config install-wake-word igris <file>")
            raise SystemExit(f"wake_word {value!r} is not installed. "
                             f"Installed: {known}.{hint}")
    if key == "agent":
        cfg = daemon.load_config(config_path)
        if value not in cfg.get("agents", {}):
            known = ", ".join(sorted(cfg.get("agents", {})))
            raise SystemExit(f"unknown agent {value!r}. Configured: {known}")
    if key == "mode" and value not in daemon.MODES:
        raise SystemExit(f"unknown mode {value!r}. "
                         f"Available: {', '.join(daemon.MODES)}")
    if key == "mode" and value != "safe":
        cfg = daemon.load_config(config_path)
        try:
            agent = daemon.Agent(cfg.get("agent", ""),
                                 cfg.get("agents", {}).get(
                                     cfg.get("agent", ""), {}))
        except ValueError as exc:
            raise SystemExit(f"cannot switch mode: {exc}")
        problems = daemon.check_mode_invariants(value, agent)
        if problems:
            raise SystemExit(f"mode {value!r} refused: {problems[0]}")
    if key == "mode" and value == "safe":
        # Safe + actions=true can never start (the daemon refuses it), so
        # accepting the write would brick the listener on next restart.
        # Disarm via the toggle or panel avatar first (both return the flag),
        # or hand-edit actions=false.
        cfg = daemon.load_config(config_path)
        name = cfg.get("agent", "")
        if cfg.get("agents", {}).get(name, {}).get("actions", False):
            raise SystemExit(
                "mode 'safe' refused while actions=true: Safe never acts. "
                "Disarm first (toggle/panel avatar returns the flag), or "
                "hand-edit actions=false.")
    if key == "voice":
        path = value if os.path.isabs(value) else os.path.join(voices_dir(), value)
        if not os.path.exists(path):
            raise SystemExit(f"no such voice file: {path}")
    if key == "model":
        # Validate that the model is available in OpenCode
        if not value:
            raise SystemExit("model setting cannot be empty")
        available = get_available_models()
        model_ids = [m["id"] for m in available]
        if value not in model_ids:
            # Show available models in error message
            available_list = ", ".join(model_ids[:5])  # Show first 5
            if len(model_ids) > 5:
                available_list += f" (and {len(model_ids) - 5} more)"
            raise SystemExit(f"model '{value}' not available. Available: {available_list}")
    if key == "listen.wake_threshold" and not 0.0 < value <= 1.0:
        raise SystemExit("wake_threshold must be between 0 and 1")
    if key == "workspace.auto_disarm_seconds" and not 60 <= value <= 3600:
        raise SystemExit("workspace.auto_disarm_seconds must be 60-3600")
    if key == "workspace.full_disarm_seconds" and not 60 <= value <= 3600:
        raise SystemExit("workspace.full_disarm_seconds must be 60-3600")
    if key.startswith("listen.") and key != "listen.wake_threshold" and value <= 0:
        raise SystemExit(f"{key} must be positive")
    if key == "draggable_avatar_enabled" and not isinstance(value, bool):
        raise SystemExit("draggable_avatar_enabled must be true or false")
    if key == "stt.engine" and value not in daemon.STT_ENGINES:
        raise SystemExit(f"unknown stt engine {value!r}. "
                         f"Available: {', '.join(daemon.STT_ENGINES)}")
    if key == "stt.model":
        cfg = daemon.load_config(config_path)
        engine = cfg.get("stt", {}).get("engine",
                                        daemon.DEFAULTS["stt"]["engine"])
        allowed = daemon.WHISPER_MODELS if engine == "whisper" \
            else daemon.PARAKEET_MODELS
        if value not in allowed:
            raise SystemExit(f"unknown {engine} model {value!r}. "
                             f"Available: {', '.join(allowed)}")
    if key in ("stt.language", "stt.fallback_engine") and not value.strip():
        raise SystemExit(f"{key} cannot be empty")
    if key == "stt.vocabulary" and len(value) > 500:
        raise SystemExit("stt vocabulary is a short bias list, not prose "
                         "(500 chars max)")


def format_value(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, float):
        # Keep it looking like the hand-written file: 1.2 not 1.2000000001
        return f"{value:g}"
    if isinstance(value, (int,)):
        return str(value)
    return '"' + str(value).replace("\\", "\\\\").replace('"', '\\"') + '"'


# Piper voices, each verified to resolve on HuggingFace. An id is
# {lang}-{name}-{quality}, which is enough to rebuild its URL, so this stays a
# flat list rather than a table of paths. Anything not listed here still works
# -- put an absolute path in `voice` and Jarvis will use it.
VOICE_BASE = "https://huggingface.co/rhasspy/piper-voices/resolve/main"
VOICE_CATALOG = [
    "en_US-amy-medium",
    "en_US-lessac-medium",
    "en_US-ryan-medium",
    "en_US-joe-medium",
    "en_US-kusal-medium",
    "en_US-hfc_female-medium",
    "en_US-bryce-medium",
    "en_GB-alan-medium",
    "en_GB-cori-medium",
    "en_GB-northern_english_male-medium",
]


def voice_url(vid, suffix=".onnx"):
    lang, name, quality = vid.split("-")
    family = lang.split("_")[0]
    return f"{VOICE_BASE}/{family}/{lang}/{name}/{quality}/{vid}{suffix}"


def voices_dir():
    return os.path.join(os.path.expanduser("~"), ".local", "share",
                        "jarvis", "voices")


def installed_voices():
    d = voices_dir()
    if not os.path.isdir(d):
        return []
    return sorted(f for f in os.listdir(d) if f.endswith(".onnx"))


TABLE_RE = re.compile(r"^\s*\[([^\]]+)\]\s*$")


def _run(argv, timeout=30):
    """Subprocess seam (tests replace this; never a shell)."""
    import subprocess
    return subprocess.run(argv, capture_output=True, timeout=timeout,
                          text=True)


def _apply_one(lines, dotted, value):
    """Replace one `key = value` line in memory, preserving comments and
    layout. The key may be top-level ("agent") or one level deep
    ("listen.cooldown"). Missing tables and missing keys are created.
    Returns "updated"/"added"; the caller writes once."""
    table, _, leaf = dotted.rpartition(".")
    rendered = f"{leaf} = {format_value(value)}"

    key_re = re.compile(rf"^(\s*){re.escape(leaf)}(\s*)=", re.ASCII)

    def trailing_comment(line):
        """The ` # ...` tail of a line, ignoring any # inside a quoted value."""
        quote = None
        for i, ch in enumerate(line):
            if quote:
                if ch == quote and line[i - 1] != "\\":
                    quote = None
            elif ch in "'\"":
                quote = ch
            elif ch == "#":
                pad = len(line[:i]) - len(line[:i].rstrip())
                return " " * max(1, pad) + line[i:]
        return ""

    current = ""          # table we are inside of, "" for top level
    table_end = None      # last line index belonging to the target table
    for i, line in enumerate(lines):
        match = TABLE_RE.match(line)
        if match:
            current = match.group(1).strip()
            if current == table:
                table_end = i
            continue
        if current == table:
            if line.strip():
                table_end = i
            if key_re.match(line):
                # Preserve the original indentation and alignment.
                indent = key_re.match(line).group(1)
                lines[i] = f"{indent}{rendered}{trailing_comment(line)}"
                return "updated"

    # Key absent: append to its table, creating the table if needed.
    if table and table_end is None:
        if lines and lines[-1].strip():
            lines.append("")
        lines.append(f"[{table}]")
        lines.append(rendered)
    elif table_end is None:
        lines.insert(0, rendered)
    else:
        lines.insert(table_end + 1, rendered)
    return "added"


def _apply_actions(lines, agent, want):
    """Flip `actions` inside [agents.<agent>] in memory. The one writer
    besides a hand-edit; refuses to invent a section or key, mirroring the
    toggle's old file writer. Returns an error string, or None on success."""
    want_text = "true" if want else "false"
    section = f"agents.{agent}"
    current, found_section = "", False
    key_re = re.compile(r"^(\s*)actions(\s*)=", re.ASCII)
    for i, line in enumerate(lines):
        match = TABLE_RE.match(line)
        if match:
            current = match.group(1).strip()
            found_section = found_section or current == section
            continue
        if current == section and key_re.match(line):
            value = line.split("#", 1)[0]
            if ("true" in value) == want:
                return None  # already what we want: touch nothing
            lines[i] = f"{key_re.match(line).group(1)}actions = {want_text}"
            return None
    if not found_section:
        return f"no [{section}] section in config; refusing to invent one"
    return f"no actions key in [{section}]; refusing to invent one"


def set_key(path, dotted, value):
    """Replace one `key = value` line, preserving comments and layout."""
    try:
        # The config path is predictable and this runs behind a GUI button,
        # so read it descriptor-first: no symlink, no blocking on a planted
        # FIFO, and a ceiling on how much we will pull in.
        lines = safefile.read_text(path, safefile.MAX_CONFIG_BYTES).splitlines()
    except FileNotFoundError:
        lines = []
    except OSError as exc:
        raise SystemExit(f"cannot read {path}: {exc}")
    result = _apply_one(lines, dotted, value)
    write(path, lines)
    return result


def write(path, lines):
    """Replace the config atomically.

    The old `path + ".tmp"` was a predictable name a local attacker could
    pre-plant as a symlink to redirect the write. safefile.write_atomic
    creates an unpredictable 0600 file in the same directory and renames it
    over the target, so a concurrent reader sees the old file or the new one.
    """
    safefile.write_atomic(path, "\n".join(lines).rstrip("\n") + "\n")


def live_state(daemon):
    """The daemon's authoritative runtime state (what the widget reads).

    The panel displays this -- it never defines it. Requests (hotkey, widget,
    panel) only write config; the daemon validates and republishes on start.
    All values are daemon-published tokens/epochs, never content.
    """
    import time
    live = {"mode": "safe", "armed": False, "remaining": 0}
    try:
        mode = safefile.read_text(daemon.MODE_FILE, 64).strip()
        if mode in daemon.MODES:
            live["mode"] = mode
    except OSError:
        return live
    try:
        import subprocess
        proc = subprocess.run(["systemctl", "--user", "is-active", "jarvis"],
                              capture_output=True, timeout=5, text=True)
        running = proc.stdout.strip() == "active"
    except OSError:
        running = False
    if not running:
        return live
    try:
        deadline = float(safefile.read_text(daemon.ARM_FILE, 64).strip())
    except (OSError, ValueError):
        deadline = None
    if live["mode"] == "safe":
        live["armed"] = True  # always-on by definition while started
    elif deadline is not None:
        remaining = int(deadline - time.time())
        if remaining > 0:
            live["armed"] = True
            live["remaining"] = remaining
    return live


def cmd_show(daemon, args):
    cfg = daemon.load_config(args.config)
    listen = daemon.merge(daemon.DEFAULTS["listen"], cfg.get("listen", {}))
    workspace = daemon.merge(daemon.DEFAULTS["workspace"],
                             cfg.get("workspace", {}))
    stt = daemon.merge(daemon.DEFAULTS["stt"], cfg.get("stt", {}))

    agents = []
    for name in sorted(cfg.get("agents", {})):
        try:
            agent = daemon.Agent(name, cfg["agents"][name])
        except ValueError:
            continue
        agents.append({
            "name": name,
            "actions": agent.actions,
            "web": agent.web,
            "installed": bool(__import__("shutil").which(agent.executable)),
            # What the daemon can honestly say about this CLI's own tools.
            # The panel must not infer "answer-only" from `actions`: that flag
            # governs Jarvis's directive broker, not the CLI's tools.
            "tools": daemon.tool_posture(agent.executable, agent.command),
        })

    print(json.dumps({
        "config_path": args.config,
        "agent": cfg.get("agent"),
        "mode": cfg.get("mode", "safe"),
        "modes": list(daemon.MODES),
        "live": live_state(daemon),
        "workspace": workspace,
        "wake_word": cfg.get("wake_word"),
        "wake_words": wake_word_list(daemon),
        "startup_error": startup_error_text(daemon),
        "voice": cfg.get("voice"),
        "model": cfg.get("model", ""),  # Add top-level model setting
        "listen": listen,
        "stt": stt,
        "agents": agents,
        "voices": voice_list(),
        "available_models": get_available_models(),  # Add available OpenCode models
    }, indent=2))
    return 0


def wake_word_list(daemon):
    """Every wake model the panel may offer: installed ones plus known
    names (today: igris) flagged not-installed, so the UI offers exactly
    what would actually work."""
    installed = daemon.wake_models()
    out = [{"name": name, "installed": True}
           for name in sorted(installed)]
    known = set(installed)
    for name in daemon.WAKE_WORDS:
        if name not in known:
            out.append({"name": name, "installed": False})
    return out


def startup_error_text(daemon):
    """Last startup refusal for the panel ("" when the listener is fine).

    Bounded daemon-published text, never transcripts or arguments.
    """
    try:
        return safefile.read_text(daemon.STARTUP_ERROR_FILE, 500).strip()
    except OSError:
        return ""


def voice_list():
    """Every voice the panel may offer: what is on disk, plus the catalog."""
    on_disk = installed_voices()
    out = [{"id": os.path.splitext(f)[0], "file": f, "installed": True}
            for f in on_disk]
    known = {v["id"] for v in out}
    for vid in VOICE_CATALOG:
        if vid not in known:
            out.append({"id": vid, "file": vid + ".onnx", "installed": False})
    return out


def opencode_models_list():
    """Get available OpenCode models by running 'opencode models' command."""
    try:
        import subprocess
        import json
        
        # Run opencode models command
        proc = subprocess.run(
            ["opencode", "models", "--format", "json"],
            capture_output=True,
            text=True,
            timeout=30
        )
        
        if proc.returncode != 0:
            # Fallback to basic list if JSON format not supported
            proc = subprocess.run(
                ["opencode", "models"],
                capture_output=True,
                text=True,
                timeout=30
            )
            if proc.returncode == 0:
                # Parse simple list format (one model per line)
                models = []
                for line in proc.stdout.strip().split('\n'):
                    if line.strip():
                        models.append({"id": line.strip(), "name": line.strip()})
                return models
            else:
                return []
        
        # Parse JSON output
        try:
            data = json.loads(proc.stdout)
            models = []
            if isinstance(data, list):
                for model in data:
                    if isinstance(model, str):
                        models.append({"id": model, "name": model})
                    elif isinstance(model, dict) and "id" in model:
                        models.append({
                            "id": model["id"],
                            "name": model.get("name", model["id"])
                        })
            elif isinstance(data, dict) and "models" in data:
                for model in data["models"]:
                    if isinstance(model, str):
                        models.append({"id": model, "name": model})
                    elif isinstance(model, dict) and "id" in model:
                        models.append({
                            "id": model["id"],
                            "name": model.get("name", model["id"])
                        })
            return models
        except (json.JSONDecodeError, KeyError):
            # If JSON parsing fails, return empty list
            return []
            
    except (subprocess.TimeoutExpired, FileNotFoundError):
        # opencode not available or timeout
        return []


# Cache for OpenCode models to avoid frequent calls
_opencode_models_cache = {"timestamp": 0, "models": []}
MODEL_CACHE_DURATION = 3600  # 1 hour in seconds


def get_available_models(force_refresh=False):
    """Get available OpenCode models with caching."""
    import time
    
    now = time.time()
    if not force_refresh and now - _opencode_models_cache["timestamp"] < MODEL_CACHE_DURATION:
        return _opencode_models_cache["models"]
    
    # Refresh cache
    models = opencode_models_list()
    _opencode_models_cache["timestamp"] = now
    _opencode_models_cache["models"] = models
    return models


def cmd_models(daemon, args):
    """List available OpenCode models."""
    provider = args.provider if hasattr(args, 'provider') and args.provider else None
    
    if provider and provider != "opencode":
        print(f"Error: Only 'opencode' provider is supported")
        return 1
    
    models = get_available_models()
    
    if not models:
        print("No OpenCode models available or opencode not installed")
        return 1
    
    if hasattr(args, 'format') and args.format == "json":
        print(json.dumps(models, indent=2))
    else:
        # Simple list format
        for model in models:
            print(model["id"])
    
    return 0


# A piper medium voice is ~63MB and its metadata a few KB. Both ceilings are
# generous; they exist so a redirected or hostile response cannot fill the
# disk while the panel sits there spinning.
MAX_VOICE_BYTES = 256 << 20
MAX_META_BYTES = 1 << 20


# Every voice the panel can install, locked to the sha256 HuggingFace served
# when tools/genvoicelock.py was last run. install.sh has always verified the
# default voice this way; the picker downloads the other nine, and a voice
# file is parsed by onnxruntime, so it gets the same treatment rather than
# being trusted because it arrived over TLS.
VOICE_LOCK = os.path.join(HERE, "voices.sha256")


def voice_hashes():
    """{filename: sha256} from the committed lock, or {} if it is missing."""
    try:
        text = safefile.read_text(VOICE_LOCK, safefile.MAX_CONFIG_BYTES)
    except OSError:
        return {}
    out = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        digest, _, name = line.partition("  ")
        if digest and name:
            out[name.strip()] = digest.strip()
    return out


def fetch(url, dest, limit, expected):
    """Download to a private temp file, verify, then rename.

    Nothing lands at `dest` until the bytes hash to `expected`, so a failed
    or tampered transfer leaves no half-written voice for piper to choke on
    and no unverified model for onnxruntime to parse. The temp file is
    unpredictably named inside the destination directory rather than the old,
    guessable `dest + ".part"`, and the transfer stops at `limit` bytes
    instead of writing whatever the server keeps sending.
    """
    import hashlib
    import urllib.error
    import urllib.request

    try:
        with safefile.private_temp(dest, suffix=".part") as (fd, tmp):
            digest = hashlib.sha256()
            written = 0
            with os.fdopen(fd, "wb") as fh:
                with urllib.request.urlopen(url, timeout=120) as response:
                    while True:
                        chunk = response.read(1 << 16)
                        if not chunk:
                            break
                        written += len(chunk)
                        if written > limit:
                            raise SystemExit(
                                f"download exceeded {limit} bytes; aborted")
                        digest.update(chunk)
                        fh.write(chunk)
            got = digest.hexdigest()
            if got != expected:
                raise SystemExit(
                    f"checksum mismatch for {os.path.basename(dest)}: "
                    f"expected {expected}, got {got}. Refusing to install it.")
            safefile.commit(tmp, dest, 0o644)
    except urllib.error.URLError as exc:
        raise SystemExit(f"download failed: {exc.reason}")


def cmd_install_voice(daemon, args):
    vid = args.voice
    if vid not in VOICE_CATALOG:
        raise SystemExit(f"unknown voice {vid!r}. "
                         f"Known: {', '.join(VOICE_CATALOG)}")

    target_dir = voices_dir()
    os.makedirs(target_dir, exist_ok=True)
    onnx = os.path.join(target_dir, vid + ".onnx")
    meta = onnx + ".json"

    expected = voice_hashes()
    if not expected:
        raise SystemExit(f"no voice checksums at {VOICE_LOCK}; "
                         "refusing to download an unverifiable voice")
    for name in (vid + ".onnx", vid + ".onnx.json"):
        if name not in expected:
            raise SystemExit(f"{name} is not in {VOICE_LOCK}; "
                             "refusing to download an unverifiable voice")

    if not os.path.exists(onnx):
        fetch(voice_url(vid), onnx, MAX_VOICE_BYTES, expected[vid + ".onnx"])
    if not os.path.exists(meta):
        fetch(voice_url(vid, ".onnx.json"), meta, MAX_META_BYTES,
              expected[vid + ".onnx.json"])

    # A truncated download and an HTML error page both land as a small file;
    # either one would fail later inside piper with nothing useful to show.
    if os.path.getsize(onnx) < 1_000_000:
        os.unlink(onnx)
        raise SystemExit("downloaded voice looks truncated; try again")
    try:
        json.loads(safefile.read_text(meta, MAX_META_BYTES))
    except (OSError, ValueError):
        raise SystemExit("voice metadata is not valid JSON; try again")

    print(f"installed {vid}")
    return 0


MAX_WAKE_BYTES = 100_000_000  # wake models are a few MB; this is a ceiling


def cmd_install_wake(daemon, args):
    """Install a wake-word model file into the custom wake dir.

    Usage: jarvis-config install-wake-word NAME PATH. Validates before it
    accepts: PATH must exist under the size ceiling, and the installed file
    must load in openWakeWord -- a corrupt download must never become a
    selectable wake word that kills the listener on restart.
    """
    name = args.name
    src = args.path
    if not name or "/" in name or name.startswith("."):
        raise SystemExit(f"bad wake-word name {name!r}")
    if not os.path.isfile(src):
        raise SystemExit(f"no such model file: {src}")
    if os.path.getsize(src) > MAX_WAKE_BYTES:
        raise SystemExit(f"model file too large (> {MAX_WAKE_BYTES} bytes)")
    target_dir = daemon.CUSTOM_WAKE_DIR
    os.makedirs(target_dir, exist_ok=True)
    base = os.path.basename(src)
    dest_name = base if base.startswith(name) and base.endswith(".onnx") \
        else name + ".onnx"
    dest = os.path.join(target_dir, dest_name)
    import shutil
    import tempfile
    fd, tmp = tempfile.mkstemp(dir=target_dir, prefix=".jarvis.")
    try:
        with os.fdopen(fd, "wb") as out, open(src, "rb") as inp:
            shutil.copyfileobj(inp, out, length=1024 * 1024)
        # Validate before accepting: the file must load as a wake model.
        from openwakeword.model import Model
        Model(wakeword_model_paths=[tmp])
        os.rename(tmp, dest)
    except Exception as exc:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise SystemExit(f"not a loadable wake-word model: {exc}")
    print(f"installed wake word {name} -> {dest}")
    return 0


def unit_is_active(unit):
    try:
        proc = _run(["systemctl", "--user", "is-active", unit], timeout=10)
    except Exception:
        return False
    return proc.stdout.strip() == "active"


def await_ready(daemon, unit, want_mode, t0, timeout):
    """Poll until the restarted listener proves it is up.

    Ready = unit active, no fresh refusal, a freshly published pipeline
    state (the daemon writes it after the mic opens), and -- when the
    transition requested a mode -- that mode published fresh. Stale files
    from a dead daemon never count: everything is gated on mtime >= t0.
    Returns an error string, or None when ready.
    """
    import time
    deadline = t0 + timeout
    while True:
        try:
            err_mtime = os.path.getmtime(daemon.STARTUP_ERROR_FILE)
        except OSError:
            err_mtime = 0
        if err_mtime >= t0:
            try:
                msg = safefile.read_text(daemon.STARTUP_ERROR_FILE,
                                         500).strip()
            except OSError:
                msg = ""
            return ("listener refused the new config: "
                    f"{msg or 'see journalctl --user -u ' + unit}")
        if unit_is_active(unit):
            try:
                state_fresh = os.path.getmtime(daemon.STATE_FILE) >= t0
            except OSError:
                state_fresh = False
            mode_ok = True
            if want_mode:
                try:
                    mode_ok = (safefile.read_text(daemon.MODE_FILE, 64)
                               .strip() == want_mode
                               and os.path.getmtime(daemon.MODE_FILE) >= t0)
                except OSError:
                    mode_ok = False
            if state_fresh and mode_ok:
                return None
        if time.time() >= deadline:
            return (f"unit did not become ready within {timeout:.0f}s "
                    f"(see journalctl --user -u {unit})")
        time.sleep(0.5)


def rollback_config(daemon, config_path, snapshot, t0):
    """Restore the pre-transition config bytes and drop a refusal the
    failed attempt wrote (stale-state recovery: the panel must not show
    an error for a config that is no longer on disk)."""
    try:
        if snapshot is None:
            try:
                os.unlink(config_path)
            except OSError:
                pass
        else:
            import tempfile
            fd, tmp = tempfile.mkstemp(
                dir=os.path.dirname(os.path.abspath(config_path)),
                prefix=".jarvis.")
            try:
                with os.fdopen(fd, "wb") as fh:
                    fh.write(snapshot)
                os.replace(tmp, config_path)
            except OSError:
                try:
                    os.unlink(tmp)
                except OSError:
                    pass
                raise
    except OSError as exc:
        return f"ROLLBACK FAILED ({exc}): config may be half-written"
    try:
        if os.path.getmtime(daemon.STARTUP_ERROR_FILE) >= t0:
            os.unlink(daemon.STARTUP_ERROR_FILE)
    except OSError:
        pass
    return None


def cmd_apply(daemon, args):
    """Atomic transition: validate everything, write once, restart at most
    once, await readiness, roll back on failure.

    Pairs are KEY=VALUE with KEY in WRITABLE plus `actions` (flips the
    actions flag in [agents.<current>] -- the toggle's physical-act path;
    the panel never sends it). Without --restart-unit this is a validated
    multi-write; with it, one restart, readiness-gated, rolled back --
    config and daemon included -- on any failure.
    """
    import time
    kinds = dict(WRITABLE)
    kinds["actions"] = "bool"
    edits = []
    for pair in args.pairs:
        if "=" not in pair:
            raise SystemExit(f"apply needs KEY=VALUE, got {pair!r}")
        key, _, raw = pair.partition("=")
        key = key.strip()
        if key not in kinds:
            raise SystemExit(
                f"{key!r} is not appliable. "
                f"Appliable: {', '.join(sorted(kinds))}")
        edits.append((key, coerce_kind(kinds[key], key, raw)))
    # Validate everything before writing anything.
    cfg = daemon.load_config(args.config)
    for key, value in edits:
        if key != "actions":
            validate(daemon, key, value, args.config)
    try:
        with open(args.config, "rb") as fh:
            snapshot = fh.read(safefile.MAX_CONFIG_BYTES + 1)
    except FileNotFoundError:
        snapshot = None
    except OSError as exc:
        raise SystemExit(f"cannot read {args.config}: {exc}")
    try:
        lines = safefile.read_text(args.config,
                                   safefile.MAX_CONFIG_BYTES).splitlines()
    except FileNotFoundError:
        lines = []
    except OSError as exc:
        raise SystemExit(f"cannot read {args.config}: {exc}")
    agent = cfg.get("agent", "")
    for key, value in edits:
        if key == "actions":
            err = _apply_actions(lines, agent, value)
            if err:
                raise SystemExit(err)
        else:
            _apply_one(lines, key, value)
    if edits:
        write(args.config, lines)
    applied = ", ".join(f"{k}={format_value(v)}" for k, v in edits)
    if not args.restart_unit:
        print(f"applied {applied or 'nothing'} "
              "(takes effect on next start)")
        return 0
    unit = args.restart_unit
    was_active = unit_is_active(unit)
    t0 = time.time()
    try:
        proc = _run(["systemctl", "--user", "restart", unit], timeout=60)
    except Exception as exc:
        proc = None
        restart_err = f"systemctl restart failed ({exc})"
    else:
        restart_err = None
        if proc.returncode != 0:
            restart_err = ("systemctl restart failed "
                           f"({(proc.stderr or proc.stdout).strip()[:160]})")

    def failed(reason):
        rb = rollback_config(daemon, args.config, snapshot, t0)
        try:
            if was_active:
                _run(["systemctl", "--user", "restart", unit], timeout=60)
            else:
                _run(["systemctl", "--user", "stop", unit], timeout=30)
        except Exception:
            pass
        msg = f"{reason}; config rolled back"
        if rb:
            msg += f"; {rb}"
        raise SystemExit(msg)

    if restart_err:
        failed(restart_err)
    want_mode = dict(edits).get("mode")
    err = await_ready(daemon, unit, want_mode, t0, args.wait_ready)
    if err:
        failed(err)
    print(f"applied {applied or 'nothing'}; {unit} restarted and ready")
    return 0


def cmd_set(daemon, args):
    if args.key not in WRITABLE:
        raise SystemExit(f"{args.key!r} is not settable from here. "
                         f"Settable: {', '.join(sorted(WRITABLE))}")
    value = coerce(args.key, args.value)
    validate(daemon, args.key, value, args.config)
    result = set_key(args.config, args.key, value)
    print(f"{result} {args.key} = {format_value(value)}")
    return 0


def main():
    parser = argparse.ArgumentParser(prog="jarvis-config")
    parser.add_argument("--config", default=CONFIG_PATH)
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("show", help="print effective settings as JSON")
    setp = sub.add_parser("set", help="change one setting")
    setp.add_argument("key")
    setp.add_argument("value")
    ap = sub.add_parser("apply",
                        help="atomic multi-key transition with readiness "
                             "and rollback")
    ap.add_argument("pairs", nargs="*", help="KEY=VALUE (plus actions=bool)")
    ap.add_argument("--restart-unit", default=None,
                    help="restart this user unit at most once and await "
                         "readiness (also starts it when inactive)")
    ap.add_argument("--wait-ready", type=float, default=25,
                    help="seconds to await readiness (default: 25)")
    iv = sub.add_parser("install-voice", help="download a piper voice")
    iv.add_argument("voice")
    iw = sub.add_parser("install-wake-word",
                        help="install a wake-word .onnx file (validated)")
    iw.add_argument("name")
    iw.add_argument("path")
    # Add models command
    mpc = sub.add_parser("models", help="list available OpenCode models")
    mpc.add_argument("provider", nargs="?", help="provider name (only 'opencode' supported)")
    mpc.add_argument("--format", choices=["json", "text"], default="text", help="output format")

    args = parser.parse_args()
    daemon = load_daemon()
    return {
        "show": cmd_show,
        "set": cmd_set,
        "apply": cmd_apply,
        "install-voice": cmd_install_voice,
        "install-wake-word": cmd_install_wake,
        "models": cmd_models,
    }[args.cmd](daemon, args)


if __name__ == "__main__":
    sys.exit(main())
