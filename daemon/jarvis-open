VOLUME_RE = re.compile(r"^(\d{1,3}|up|down|mute|unmute)$")
BRIGHTNESS_RE = re.compile(r"^(\d{1,3}|up|down)$")
WORKSPACE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9 _.\-]{0,31}$")
MUTE_RE = re.compile(r"^(on|off|toggle|mute|unmute)$")
MEDIA_RE = re.compile(r"^(play|pause|toggle|next|prev|stop|quit)$")
MEDIA_METHOD = {"play": "Play", "pause": "Pause", "toggle": "PlayPause",
                "next": "Next", "prev": "Previous", "stop": "Stop"}
MUSIC_QUERY_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9 +.'\-]{0,79}$")
WATCH_RE = re.compile(r"^https://www\.youtube\.com/watch\?v=[A-Za-z0-9_-]{11}(&autoplay=1)?$")
WATCH_LIST_RE = re.compile(
    r"^https://www\.youtube\.com/watch\?v=[A-Za-z0-9_-]{11}"
    r"&list=[A-Za-z0-9_-]{10,64}(&autoplay=1)?$")
PLAYLIST_PAGE_RE = re.compile(
    r"^https://www\.youtube\.com/playlist\?list=[A-Za-z0-9_-]{2,64}$")
PLAYLIST_ID_RE = re.compile(r"^[A-Za-z0-9_-]{10,64}$")
MYMUSIC_RE = re.compile(
    r"^(liked|favourites|favorites|watchlater|watch later"
    r"|playlist [A-Za-z0-9 _.'\-]{1,40})$")

CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
CONFIG_PATH = os.path.join(CONFIG_HOME, "jarvis", "config.toml")


def run_cmd(argv, timeout=10, out_limit=500):
    """Run one allowlisted argv, no shell, bounded. Returns (rc, output)."""
    try:
        proc = subprocess.run(argv, stdin=subprocess.DEVNULL,
                              stdout=subprocess.PIPE,
                              stderr=subprocess.PIPE, timeout=timeout,
                              check=False)
    except (OSError, subprocess.TimeoutExpired) as exc:
        print(f"backend failed: {exc}", file=sys.stderr)
        return 1, ""
    cap = max(64, min(int(out_limit), 32 << 10))
    out = (proc.stdout or b"").decode("utf-8", "replace").strip()[:cap]
    if proc.returncode != 0:
        err = (proc.stderr or b"").decode("utf-8", "replace").strip()[:200]
        print(f"backend refused: {err or out or proc.returncode}",
              file=sys.stderr)
        return proc.returncode or 1, ""
    return 0, out


def cmd_volume(value):
    if not VOLUME_RE.match(value):
        print("refusing bad volume value", file=sys.stderr)
        return 1
    if value.isdigit():
        pct = int(value)
        if not 0 <= pct <= 100:
            print("refusing out-of-range volume", file=sys.stderr)
            return 1
        rc, _ = run_cmd(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@",
                         f"{pct}%"])
        if rc == 0:
            print(f"volume {pct}%")
        return rc
    if value in ("mute",):
        rc, _ = run_cmd(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "1"])
        if rc == 0:
            print("muted")
        return rc
    if value in ("unmute",):
        rc, _ = run_cmd(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "0"])
        if rc == 0:
            print("unmuted")
        return rc
    if value == "up":
        rc, _ = run_cmd(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@",
                         "5%+"])
        if rc == 0:
            print("volume up")
        return rc
    if value == "down":
        rc, _ = run_cmd(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@",
                         "5%-"])
        if rc == 0:
            print("volume down")
        return rc
    print("refusing bad volume value", file=sys.stderr)
    return 1


def cmd_brightness(value):
    if not BRIGHTNESS_RE.match(value):
        print("refusing bad brightness value", file=sys.stderr)
        return 1
    if value.isdigit():
        pct = int(value)
        if not 1 <= pct <= 100:
            print("refusing out-of-range brightness", file=sys.stderr)
            return 1
        rc, _ = run_cmd(["brightnessctl", "set", f"{pct}%"])
        if rc == 0:
            print(f"brightness {pct}%")
        return rc
    if value == "up":
        rc, _ = run_cmd(["brightnessctl", "set", "+5%"])
        if rc == 0:
            print("brightness up")
        return rc
    rc, _ = run_cmd(["brightnessctl", "set", "5%-"])
    if rc == 0:
        print("brightness down")
    return rc


def cmd_workspace(value):
    # Hyprland 0.55+ speaks Lua: dispatch is shorthand for eval
    # 'hl.dispatch(...)'. Verified live on 0.56.2: focus({workspace})
    # accepts names, numbers and +1/-1; plain `dispatch workspace N`
    # dies in the Lua parser, so nothing here uses the legacy form.
    if value == "next":
        value = "+1"
    elif value == "previous":
        value = "-1"
    if value in ("+1", "-1"):
        expr = f'hl.dsp.focus({{ workspace = "{value}" }})'
    else:
        if not WORKSPACE_RE.match(value):
            print("refusing bad workspace name", file=sys.stderr)
            return 1
        expr = f'hl.dsp.focus({{ workspace = "{value}" }})'
    if hypr(expr):
        print(f"workspace {value}")
        return 0
    return 1


def hypr(lua):
    """Run one Lua dispatcher expression. Only ever called with strings
    built from validated tokens (names/numbers/addresses matched above),
    never free speech: a quote or backslash cannot survive the regexes, so
    none can break out of the quoted Lua string."""
    rc, out = run_cmd(["hyprctl", "dispatch", lua])
    # hyprctl exits 0 even when the compositor refuses: success is the
    # literal "ok", anything else (error: ...) is a refusal.
    if rc == 0 and out.strip() == "ok":
        return True
    if rc == 0:
        print(f"compositor refused: {out[:160]}", file=sys.stderr)
    return False


def hypr_json(args, limit=1 << 20):
    """Bounded JSON query (clients/activewindow). None on any failure."""
    import json
    try:
        proc = subprocess.run(args, stdin=subprocess.DEVNULL,
                              stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL, timeout=10,
                              check=False)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if proc.returncode != 0:
        return None
    try:
        return json.loads((proc.stdout or b"")[:limit].decode("utf-8",
                                                              "replace"))
    except ValueError:
        return None


def find_window(query):
    """(address, class) of one running window: exact class/title first,
    then substring -- first hit wins, mirroring app resolution. The
    address (hex, re-validated) is what later expressions use, so no
    window title text ever reaches the Lua string. "this"/"current" names
    the focused window (for "move this window to ...")."""
    if query in ("this", "current"):
        active = hypr_json(["hyprctl", "activewindow", "-j"])
        if isinstance(active, dict):
            addr = str(active.get("address", ""))
            if actions.ADDRESS_RE.match(addr):
                return addr, str(active.get("class", "active"))
        return None
    if not actions.FOCUS_QUERY_RE.match(query):
        return None
    clients = hypr_json(["hyprctl", "clients", "-j"])
    if not isinstance(clients, list):
        return None
    q = query.lower()
    candidates = []
    for c in clients:
        if not isinstance(c, dict):
            continue
        cls = str(c.get("class", ""))
        title = str(c.get("title", ""))
        addr = str(c.get("address", ""))
        if not actions.ADDRESS_RE.match(addr):
            continue
        candidates.append((addr, cls, title))
    for addr, cls, title in candidates:
        if q in (cls.lower(), title.lower()):
            return addr, cls
    for addr, cls, title in candidates:
        if q in cls.lower() or q in title.lower():
            return addr, cls
    return None


def cmd_focus_window(query):
    found = find_window(query)
    if found is None:
        print(f"no running window matches '{query}'", file=sys.stderr)
        return 1
    addr, cls = found
    if hypr(f'hl.dsp.focus({{ window = "address:{addr}" }})'):
        print(f"focused {cls}")
        return 0
    return 1


def cmd_move_window(query, target):
    if target == "next":
        target = "+1"
    elif target == "previous":
        target = "-1"
    if target not in ("+1", "-1") and not WORKSPACE_RE.match(target):
        print("refusing bad workspace name", file=sys.stderr)
        return 1
    found = find_window(query)
    if found is None:
        print(f"no running window matches '{query}'", file=sys.stderr)
        return 1
    addr, cls = found
    # Move first (address-scoped, exact), then follow it there.
    if not hypr(f'hl.dsp.window.move({{ workspace = "{target}" }})'):
        return 1
    hypr(f'hl.dsp.focus({{ window = "address:{addr}" }})')
    print(f"moved {cls} to workspace {target}")
    return 0


def cmd_fullscreen():
    # Toggle: verified live (2 -> 0 -> 2). No absolute mode exists in the
    # Lua surface we probed, so the grammar offers the toggle only.
    if hypr("hl.dsp.window.fullscreen({})"):
        print("fullscreen toggled")
        return 0
    return 1


def cmd_lock():
    rc, _ = run_cmd(["loginctl", "lock-session"])
    if rc == 0:
        print("screen locked")
    return rc


def cmd_screenshot(mode):
    if mode not in ("full", "window"):
        print("refusing bad screenshot mode", file=sys.stderr)
        return 1
    import time
    pictures = os.path.join(HOME, "Pictures")
    try:
        os.makedirs(pictures, exist_ok=True)
    except OSError as exc:
        print(f"cannot use ~/Pictures ({exc})", file=sys.stderr)
        return 1
    stamp = time.strftime("%Y%m%d-%H%M%S")
    path = os.path.join(pictures, f"jarvis-{stamp}.png")
    if mode == "window":
        active = hypr_json(["hyprctl", "activewindow", "-j"])
        try:
            x, y = int(active["at"][0]), int(active["at"][1])
            w, h = int(active["size"][0]), int(active["size"][1])
        except (TypeError, KeyError, IndexError, ValueError):
            print("no active window geometry", file=sys.stderr)
            return 1
        if not all(v >= -16384 and v <= 16384 for v in (x, y, w, h)):
            print("refusing implausible geometry", file=sys.stderr)
            return 1
        if w <= 0 or h <= 0:
            print("refusing empty geometry", file=sys.stderr)
            return 1
        geometry = f"{x},{y} {w}x{h}"
        rc, _ = run_cmd(["grim", "-g", geometry, path], timeout=20)
    else:
        rc, _ = run_cmd(["grim", path], timeout=20)
    if rc == 0:
        print(f"screenshot saved (path not journaled)")
    return rc


def cmd_notify(text):
    if not actions.NOTIFY_RE.match(text):
        print("refusing bad notification text", file=sys.stderr)
        return 1
    rc, _ = run_cmd(["notify-send", "-a", "Jarvis", "Jarvis", text])
    if rc == 0:
        # The text itself is speech: confirm delivery, never echo it.
        print("notification sent")
    return rc


def cmd_close_window():
    # Focused window only: targeting a named window by voice risks closing
    # the wrong one, and the focused one is what the user is looking at.
    if hypr("hl.dsp.window.close()"):
        print("window closed")
        return 0
    return 1


def cmd_logout():
    if hypr("hl.dsp.exit()"):
        print("logged out")
        return 0
    return 1


def cmd_reboot():
    rc, _ = run_cmd(["systemctl", "reboot"])
    return rc


def cmd_poweroff():
    rc, _ = run_cmd(["systemctl", "poweroff"])
    return rc


def cmd_wifi(value):
    if not actions.WIFI_RE.match(value):
        print("refusing bad wifi value", file=sys.stderr)
        return 1
    rc, _ = run_cmd(["nmcli", "radio", "wifi", value])
    if rc == 0:
        print(f"wi-fi {value}")
    return rc


def split_button(rest):
    """Trailing --confirm-button: a supervised caller (Confirm tap, --ask
    at a keyboard) attests the action. Voice never passes it."""
    if rest and rest[-1] == "--confirm-button":
        return rest[:-1], True
    return rest, False


def stage_or_run(action, args, confirmed, runner):
    """needs_confirm verbs: without supervised attestation, stage the
    request for on-screen approval and exit 2. The UI offers Confirm/Deny;
    only `jarvis-open confirm` executes."""
    if confirmed:
        return runner()
    request = actions.build_request(action, args, source="voice")
    if request is None or not request["needs_confirm"]:
        print("refusing invalid arguments", file=sys.stderr)
        return 1
    if actions.write_pending(request):
        print(f"needs on-screen confirmation: {actions.describe(request)}",
              file=sys.stderr)
        return 2
    print("cannot stage confirmation; refusing", file=sys.stderr)
    return 1


CONFIRMED_RUNNERS = {
    "close-window": lambda args: cmd_close_window(),
    "logout": lambda args: cmd_logout(),
    "reboot": lambda args: cmd_reboot(),
    "poweroff": lambda args: cmd_poweroff(),
    "wifi": lambda args: cmd_wifi(args["value"]),
}


def cmd_confirm():
    pending = actions.read_pending()
    if pending is None:
        print("nothing pending confirmation", file=sys.stderr)
        return 1
    runner = CONFIRMED_RUNNERS.get(pending["action"])
    if runner is None:
        actions.clear_pending()
        print("refusing unknown pending action", file=sys.stderr)
        return 1
    rc = runner(pending["args"])
    actions.clear_pending()
    if rc == 0:
        print(f"confirmed: {pending.get('description', pending['action'])}")
    return rc


def cmd_deny():
    pending = actions.read_pending()
    actions.clear_pending()
    if pending is None:
        print("nothing pending confirmation", file=sys.stderr)
        return 1
    print("denied (nothing ran)")
    return 0


def cmd_mute(value):
    if not MUTE_RE.match(value):
        print("refusing bad mute value", file=sys.stderr)
        return 1
    want = {"on": "1", "mute": "1", "off": "0", "unmute": "0"}.get(value)
    if want is None:  # toggle
        rc, _ = run_cmd(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@",
                         "toggle"])
        if rc == 0:
            print("mute toggled")
        return rc
    rc, _ = run_cmd(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", want])
    if rc == 0:
        print("muted" if want == "1" else "unmuted")
    return rc


XESAM_URL_RE = re.compile(
    r'"xesam:url"\s+s\s+"((?:https?://)[^"\\]{1,500})"')


def mpris_track_url(players=None):
    """https? URL from MPRIS Metadata xesam:url, preferring mpv."""
    if players is None:
        players = mpris_players()
    ordered = [p for p in players if ".mpv" in p.lower()] + [
        p for p in players if ".mpv" not in p.lower()]
    for bus in ordered:
        rc, out = run_cmd(
            ["busctl", "--user", "get-property", bus,
             "/org/mpris/MediaPlayer2",
             "org.mpris.MediaPlayer2.Player", "Metadata"],
            timeout=5, out_limit=8000)
        if rc != 0 or not out:
            continue
        match = XESAM_URL_RE.search(out)
        if match:
            return match.group(1)
    return None


def cmd_media_link():
    """Open the playing/paused track URL in Chromium."""
    url = mpris_track_url()
    if not url:
        print("no track URL on any media player", file=sys.stderr)
        return 1
    if not (url.startswith("http://") or url.startswith("https://")):
        print("refusing non-http track URL", file=sys.stderr)
        return 1
    if have("uwsm"):
        spawn(["uwsm", "app", "--", "chromium", url])
    elif have("chromium"):
        spawn(["chromium", url])
    else:
        print("chromium not available", file=sys.stderr)
        return 1
    print("opened track in chromium")
    return 0


def mpris_players():
    """Sorted MPRIS player bus names (browsers, music apps), or []."""
    try:
        proc = subprocess.run(
            ["busctl", "--user", "list", "--no-legend"],
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL, timeout=5, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return []
    if proc.returncode != 0:
        return []
    players = []
    for line in (proc.stdout or b"").decode("utf-8", "replace").splitlines():
        name = line.split()[0] if line.split() else ""
        if name.startswith("org.mpris.MediaPlayer2."):
            players.append(name)
    return sorted(players)


def cmd_media(value):
    if not MEDIA_RE.match(value):
        print("refusing bad media value", file=sys.stderr)
        return 1
    players = mpris_players()
    if not players:
        print("no media players running", file=sys.stderr)
        return 1
    if value == "quit":
        # Quit closes a player outright, so it is scoped to the mpv mini
        # player only: quitting whatever happens to be first (a browser!)
        # would nuke the user's session. No mpv, no quit.
        mpvs = [p for p in players if ".mpv" in p.lower()]
        if not mpvs:
            print("quit is only for the mpv mini player (none running)",
                  file=sys.stderr)
            return 1
        rc, _ = run_cmd(["gdbus", "call", "--session",
                         "--dest", mpvs[0],
                         "--object-path", "/org/mpris/MediaPlayer2",
                         "--method", "org.mpris.MediaPlayer2.Quit"])
        if rc == 0:
            print("mini player closed")
        return rc
    # Deterministic: the first player, transport key only. No content is
    # named, read or selected -- pause/resume/skip and nothing else.
    method = MEDIA_METHOD[value]
    rc, _ = run_cmd(["gdbus", "call", "--session",
                     "--dest", players[0],
                     "--object-path", "/org/mpris/MediaPlayer2",
                     "--method", f"org.mpris.MediaPlayer2.Player.{method}"])
    if rc == 0:
        print(f"media {value} ({players[0].split('.')[-1]})")
    return rc


def music_player(config_path=None):
    """Playback backend from [music] player: "browser" (default, opens the
    video page) or "mpv" (audio only, no window -- mpv exposes MPRIS, so the
    media verb then pauses/skips it and the widget shows it). Anything else
    refuses: an explicit misconfiguration must surface, not surprise."""
    if config_path is None:
        config_path = CONFIG_PATH
    try:
        text = safefile.read_text(config_path, safefile.MAX_CONFIG_BYTES)
    except OSError:
        return "browser"
    current = ""
    for line in text.splitlines():
        match = re.match(r"^\s*\[([^\]]+)\]\s*$", line)
        if match:
            current = match.group(1).strip()
            continue
        if current == "music":
            pair = re.match(r"^\s*player\s*=\s*\"([^\"]{1,16})\"\s*(?:#.*)?$",
                            line)
            if pair:
                return pair.group(1).strip()
    return "browser"


def play_target(url, allowed, config_path=None):
    """Play/resolve validated URL through the configured backend."""
    if not any(pat.match(url) for pat in allowed):
        print("broker resolved something unexpected; refusing", file=sys.stderr)
        return 1
    backend = music_player(config_path)
    if backend in ("mpv", "mpv-video"):
        mpv = shutil.which("mpv")
        if mpv is None:
            print("mpv configured but not installed", file=sys.stderr)
            return 1
        if backend == "mpv":
            # Audio only, no window: mpv registers an MPRIS player, so
            # pause / next keep working through the media verb.
            argv = [mpv, "--no-video", "--no-terminal",
                    "--ytdl-raw-options=extractor-args=youtube:player_client=android",
                    "--ytdl-format=best[height<=360]/best", url]
        else:
            # Visible mini player: small always-on-top window, capped at
            # 480p to keep it light. Same MPRIS controls as audio mode.
            argv = [mpv, "--force-window", "--geometry=480x270",
                    "--ontop", "--no-terminal",
                    "--ytdl-raw-options=extractor-args=youtube:player_client=android",
                    "--ytdl-format=bestvideo[height<=480]+bestaudio/best[height<=480]/best",
                    url]
        spawn(argv)
        print("playing (url not journaled)")
        return 0
    if backend != "browser":
        print('unknown [music] player %r; want "browser", "mpv" or '
              '"mpv-video"' % (backend,), file=sys.stderr)
        return 1
    spawn(["xdg-open", url])
    print("opened (url not journaled)")
    return 0


def ytdlp_path():
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        candidate = os.path.join(directory, "yt-dlp")
        if directory and os.access(candidate, os.X_OK):
            return candidate
    return None


def cmd_music(query):
    """Open the top YouTube result for a validated query. Anonymous: no
    account, no cookies, no credentials anywhere -- pure public search."""
    if not MUSIC_QUERY_RE.match(query):
        print("refusing bad music query", file=sys.stderr)
        return 1
    yt = ytdlp_path()
    if yt is None:
        print("yt-dlp not installed", file=sys.stderr)
        return 1
    rc, out = run_cmd(
        [yt, "--no-playlist", "--no-warnings", "--skip-download",
         "--print", "%(webpage_url)s", f"ytsearch1:{query}"], timeout=30)
    if rc != 0 or not out:
        print("no result for that search", file=sys.stderr)
        return 1
    # autoplay=1 asks the page to start playing at once. Whether audible
    # autoplay actually starts is the browser's call (media-engagement
    # policy): regular YouTube watchers pass it, everyone else is one click
    # away on an already-open video.
    url = out.splitlines()[0].strip()
    if "autoplay=1" not in url:
        url += "&autoplay=1"
    return play_target(url, (WATCH_RE,))


def read_music_playlists(config_path=None):
    """{lowercased name: playlist id} from [music.playlists]. Strict subset
    parse: `name = "ID"` lines only, IDs re-validated by the caller."""
    if config_path is None:
        config_path = CONFIG_PATH
    try:
        text = safefile.read_text(config_path, safefile.MAX_CONFIG_BYTES)
    except OSError:
        return {}
    current, found = "", {}
    for line in text.splitlines():
        match = re.match(r"^\s*\[([^\]]+)\]\s*$", line)
        if match:
            current = match.group(1).strip()
            continue
        if current != "music.playlists":
            continue
        pair = re.match(
            r"^\s*([A-Za-z0-9 _.'\-]{1,40})\s*=\s*\"([^\"]{1,64})\"\s*(?:#.*)?$",
            line)
        if pair:
            found[pair.group(1).strip().lower()] = pair.group(2).strip()
    return found


def cmd_mymusic(spec):
    """Your library, in your logged-in browser. No credentials here: the
    login lives in the default browser profile that xdg-open targets, and
    account listing would need cookie decryption this broker deliberately
    cannot do. So: liked/watch-later open their pages (you pick), and named
    playlists from [music.playlists] autoplay their first public video --
    falling back to the playlist page when the contents are private."""
    norm = " ".join(spec.lower().split())
    if not MYMUSIC_RE.match(norm):
        print("refusing bad mymusic spec", file=sys.stderr)
        return 1
    if norm in ("liked", "favourites", "favorites"):
        return play_target(
            "https://www.youtube.com/playlist?list=LL", (PLAYLIST_PAGE_RE,))
    if norm in ("watchlater", "watch later"):
        return play_target(
            "https://www.youtube.com/playlist?list=WL", (PLAYLIST_PAGE_RE,))
    name = norm[len("playlist "):].strip()
    playlists = read_music_playlists()
    pid = playlists.get(name)
    if pid is None or not PLAYLIST_ID_RE.match(pid):
        known = ", ".join(sorted(playlists)) or "none"
        print(f"no playlist {name!r} in [music.playlists] "
              f"(have: {known})", file=sys.stderr)
        return 1
    page = f"https://www.youtube.com/playlist?list={pid}"
    yt = ytdlp_path()
    if yt is not None:
        # Public playlists: resolve the first video anonymously and open it
        # playing inside the list. Private ones fail here -> page fallback.
        rc, out = run_cmd(
            [yt, "--flat-playlist", "--playlist-items", "1",
             "--no-warnings", "--skip-download", "--print", "id", page],
            timeout=25)
        vid = (out or "").splitlines()[0].strip() if rc == 0 else ""
        if rc == 0 and re.match(r"^[A-Za-z0-9_-]{11}$", vid):
            return play_target(
                f"https://www.youtube.com/watch?v={vid}&list={pid}&autoplay=1",
                (WATCH_LIST_RE,))
    return play_target(page, (PLAYLIST_PAGE_RE,))


def main(argv):
    if not argv:
        return usage()
    command, rest = argv[0], argv[1:]

    if command == "list":
        for _, name in entries():
            print(name)
        return 0

    if command == "app":
        if not rest:
            return usage()
        query = " ".join(rest)
        role = OMARCHY_LAUNCH.get(query.lower())
        if role is not None and have("omarchy"):
            spawn(role)
            print(f"launched {query.lower()}")
            return 0
        entry_id = resolve(query)
        if entry_id is None:
            print(f"no installed app matches '{query}'", file=sys.stderr)
            return 1
        launch(entry_id)
        print(f"launched {entry_id}")
        return 0

    if command == "url":
        if len(rest) != 1:
            return usage()
        url = rest[0]
        # Only ever hand a real web URL to the browser.
        if not URL_RE.match(url):
            print("refusing non-http(s) url", file=sys.stderr)
            return 1
        spawn(["xdg-open", url])
        print(f"opened {url}")
        return 0

    if command == "volume":
        if len(rest) != 1:
            return usage()
        return cmd_volume(rest[0])

    if command == "brightness":
        if len(rest) != 1:
            return usage()
        return cmd_brightness(rest[0])

    if command == "workspace":
        if len(rest) != 1:
            return usage()
        return cmd_workspace(rest[0])

    if command == "mute":
        if len(rest) != 1:
            return usage()
        return cmd_mute(rest[0])

    if command == "media":
        if len(rest) != 1:
            return usage()
        return cmd_media(rest[0])

    if command == "media-link":
        if rest:
            return usage()
        return cmd_media_link()

    if command == "music":
        if len(rest) != 1:
            return usage()
        return cmd_music(rest[0])

    if command == "mymusic":
        if len(rest) != 1:
            return usage()
        return cmd_mymusic(rest[0])

    if command == "focus-window":
        if len(rest) != 1:
            return usage()
        return cmd_focus_window(rest[0])

    if command == "move-window":
        if len(rest) != 2:
            return usage()
        return cmd_move_window(rest[0], rest[1])

    if command == "fullscreen":
        if rest:
            return usage()
        return cmd_fullscreen()

    if command == "lock":
        if rest:
            return usage()
        return cmd_lock()

    if command == "screenshot":
        if len(rest) > 1:
            return usage()
        return cmd_screenshot(rest[0] if rest else "full")

    if command == "notify":
        if len(rest) != 1:
            return usage()
        return cmd_notify(rest[0])

    # State-destructive or security-sensitive: without a supervised
    # --confirm-button these stage an on-screen confirmation and exit 2.
    if command == "close-window":
        rest, confirmed = split_button(rest)
        if rest:
            return usage()
        return stage_or_run("close-window", {}, confirmed,
                            cmd_close_window)

    if command == "logout":
        rest, confirmed = split_button(rest)
        if rest:
            return usage()
        return stage_or_run("logout", {}, confirmed, cmd_logout)

    if command == "reboot":
        rest, confirmed = split_button(rest)
        if rest:
            return usage()
        return stage_or_run("reboot", {}, confirmed, cmd_reboot)

    if command == "poweroff":
        rest, confirmed = split_button(rest)
        if rest:
            return usage()
        return stage_or_run("poweroff", {}, confirmed, cmd_poweroff)

    if command == "wifi":
        rest, confirmed = split_button(rest)
        if len(rest) != 1:
            return usage()
        value = rest[0]
        if not actions.WIFI_RE.match(value):
            print("refusing bad wifi value", file=sys.stderr)
            return 1
        return stage_or_run("wifi", {"value": value}, confirmed,
                            lambda: cmd_wifi(value))

    if command == "confirm":
        if rest:
            return usage()
        return cmd_confirm()

    if command == "deny":
        if rest:
            return usage()
        return cmd_deny()

    return usage()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
